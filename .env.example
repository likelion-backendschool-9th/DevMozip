# 프로젝트 격리 이름. 호스트에서는 팀별 이름으로 설정
COMPOSE_PROJECT_NAME=devmozip
FRONTEND_PORT=3000
BACKEND_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443
DB_PORT=5432
DB_NAME=devmozip
DB_USER=devmozip
# 아래 자리표시를 로컬/호스트에서 직접 교체한다. .env는 커밋하지 않는다.
DB_PASSWORD=replace-with-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_USER_USERNAME=member@devmozip.demo
AUTH_USER_PASSWORD=replace-with-user-password
AUTH_ADMIN_USERNAME=admin@devmozip.demo
AUTH_ADMIN_PASSWORD=replace-with-admin-password
# 카카오 로그인. 값이 없으면 카카오 기능만 쓸 수 없고 서버는 정상 기동한다.
# {DOMAINNAME}/{KAKAO_REDIRECT_URI}가 카카오 콘솔에 등록한 Redirect URI와 정확히 같아야 한다.
KAKAO_REST_API=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=api/auth/kakao/callback
# 서비스 주소. http:// 또는 https://로 시작하고 끝에 /를 붙이지 않는다.
DOMAINNAME=
# 운영 팀 nginx 포트. 호스트 관리자가 할당한 값으로 교체
TEAM_PORT=3002
IMAGE_PREFIX=ghcr.io/likelion-backendschool-9th/devmozip
IMAGE_TAG=latest
